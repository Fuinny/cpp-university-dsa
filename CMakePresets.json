{
    "version": 8,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "clang-debug",
            "displayName": "Clang Debug",
            "description": "Debug build with all warnings enabled",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_CXX_FLAGS_DEBUG": "-std=c++23 -g -Wall -Wextra -Wpedantic -Weffc++ -Wconversion -Wsign-conversion -Werror"
            }
        },
        {
            "name": "clang-release",
            "displayName": "Clang Release",
            "description": "Optimized release build with compiler optimizations and debug symbols disabled",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_CXX_FLAGS_RELEASE": "-std=c++23 -O2 -DNDEBUG"
            }
        }
    ]
}
